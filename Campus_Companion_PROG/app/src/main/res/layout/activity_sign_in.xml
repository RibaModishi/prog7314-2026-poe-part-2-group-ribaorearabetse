<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_geometric_lines"
    android:padding="24dp">

    <!-- Top Navigation Row -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Back Arrow Button Container -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_translucent_icon"
            android:contentDescription="Back"
            android:src="@drawable/ic_school"
            app:tint="#FFFFFF" />

        <!-- Lock Icon Badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_translucent_icon">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔐"
                android:textSize="26sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Header Text -->
    <LinearLayout
        android:id="@+id/headerTextLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Use your university Microsoft account."
            android:textColor="@color/text_white_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main Form White Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerTextLayout"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_white_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Field Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Email"
            android:textColor="#1F2937"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Outlined Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#E5E7EB"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStudentEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="student@university.ac.za"
                android:inputType="textEmailAddress"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Red Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMicrosoftSso"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="Continue with Microsoft SSO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/red_primary"
            app:cornerRadius="27dp" />

        <!-- Divider Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="16dp"
            android:text="or"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <!-- Biometric Button with Hand Emoji -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBiometric"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="👋   Use Biometric Login"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp" />

        <!-- Footnote text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Campus Companion uses Microsoft Entra ID. Your password is never stored by us."
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>