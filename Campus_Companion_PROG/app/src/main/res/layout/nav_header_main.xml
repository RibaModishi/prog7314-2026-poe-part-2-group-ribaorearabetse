<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@drawable/bg_white_card"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#DC2626"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvNavHeaderInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="CC"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNavHeaderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campus Companion PROG"
        android:textColor="#111827"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNavHeaderEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="student@university.ac.za"
        android:textColor="#6B7280"
        android:textSize="13sp" />

</LinearLayout>